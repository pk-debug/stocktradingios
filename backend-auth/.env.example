# Public values must match Configuration/Identity.xcconfig.
NORTHSTAR_IDENTITY_ISSUER=https://your-tenant.example.auth0.com/
NORTHSTAR_IDENTITY_AUDIENCE=https://northstar-paper-api
NORTHSTAR_DB=/data/northstar.sqlite3
# For direct local uvicorn, override this with a writable absolute path.
# SERVER ONLY: enter real values securely in hosting settings, never in iOS or Git.
NORTHSTAR_MANAGEMENT_CLIENT_ID=
NORTHSTAR_MANAGEMENT_CLIENT_SECRET=
